from flask import Flask, render_template, request, jsonify, session
from google import genai
import os
import json
import re
import random

app = Flask(__name__)
app.secret_key = os.getenv("FLASK_SECRET_KEY", "change-this-secret")

# Connect to Gemini AI
api_key = os.getenv("GEMINI_API_KEY")
client = genai.Client(api_key=api_key) if api_key else None

# Backup puzzles if AI is unavailable
backup_puzzles = [
    {
        "question": "I have keys but no locks. I have space but no room. What am I?",
        "answer": "keyboard",
        "hint": "You use me to type."
    },
    {
        "question": "What has hands but cannot clap?",
        "answer": "clock",
        "hint": "You can find me on a wall."
    },
    {
        "question": "The more you take, the more you leave behind. What am I?",
        "answer": "footsteps",
        "hint": "Think about walking."
    }
]


def generate_puzzle():
    if client:
        try:
            response = client.models.generate_content(
                model="gemini-2.5-flash",
                contents="""
                Create one creative escape room riddle.
                Return ONLY valid JSON in this format:
                {
                    "question": "Riddle text",
                    "answer": "one short answer",
                    "hint": "A useful hint without revealing answer"
                }
                """
            )

            data = response.text.strip()
            data = re.sub(r"^```(?:json)?\s*|\s*```$", "", data)
            puzzle = json.loads(data)

            if all(k in puzzle for k in ("question", "answer", "hint")):
                return puzzle

        except Exception as e:
            print("AI error:", e)

    return random.choice(backup_puzzles)


@app.route("/")
def home():
    return render_template("index.html")


@app.route("/api/start", methods=["POST"])
def start_game():
    puzzle = generate_puzzle()

    # Keep the answer on the server
    session["answer"] = puzzle["answer"].strip().lower()
    session["hint"] = puzzle["hint"]
    session["score"] = 100

    return jsonify({
        "question": puzzle["question"],
        "score": 100
    })


@app.route("/api/check", methods=["POST"])
def check_answer():
    data = request.get_json(silent=True) or {}
    user_answer = data.get("answer", "").strip().lower()

    correct_answer = session.get("answer")

    if not correct_answer:
        return jsonify({"message": "Start a new game first."}), 400

    if user_answer == correct_answer:
        return jsonify({
            "correct": True,
            "message": "Congratulations! You escaped the room!",
            "score": session.get("score", 100)
        })

    session["score"] = max(0, session.get("score", 100) - 10)

    return jsonify({
        "correct": False,
        "message": "Wrong answer! Try again.",
        "score": session["score"]
    })


@app.route("/api/hint", methods=["GET"])
def get_hint():
    if "hint" not in session:
        return jsonify({"hint": "Start a game first."}), 400

    session["score"] = max(0, session.get("score", 100) - 5)

    return jsonify({
        "hint": session["hint"],
        "score": session["score"]
    })


if __name__ == "__main__":
    app.run(debug=True)
